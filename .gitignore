.DS_Store
.env*.local
.env.local.save
# Auch Sicherungen mit Suffix: `.env*.local` greift NICHT bei `.env.local.bak-024453`,
# weil der Stern nicht ueber den Punkt hinaus passt. Genau so eine Datei lag am
# 03.08.2026 ungeschuetzt im Verzeichnis — ein `git add .` haette alle Schluessel
# veroeffentlicht (Supabase-Service-Key, Stripe, OpenAI).
.env.local.*
.env.*.bak*
# EIN STERN STATT EINES SCHRAEGSTRICHS (31.08.2026): `.next/` trifft nur den Dev-Bau.
# `.next-build`, `.next-claude` und `.next-pruef` standen einzeln weiter unten -- der Stern
# fasst sie zusammen und faengt kuenftige Varianten gleich mit. Rein aufraeumend; hochgeladen
# wurden sie nie, sie waren schon vorher ignoriert.
.next*
node_modules/
outputs/
work/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
state-backup-*.json
.claude/
.vercel

# Local video backups (large, never commit)
video-backup/
video-samples/
state-backup-*.json

# Prüfbauten neben dem laufenden Entwicklungsserver
